---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CategoryCards from '../components/CategoryCards.astro';
import FilterBar from '../components/FilterBar.astro';
import CardGrid from '../components/CardGrid.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import { stripMarkdown } from '../lib/utils';

const articles = await getCollection('articles');
const projects = await getCollection('projects');
const randomNotes = await getCollection('random');

type CardLike = {
  slug: string;
  collection: string;
  data: {
    title: string;
    description: string;
    date: Date;
    category: string;
    tags?: string[];
    featured?: boolean;
    cover?: string;
  };
};

const randomCards: CardLike[] = randomNotes.map((entry) => ({
  slug: entry.slug,
  collection: 'random',
  data: {
    title: '碎碎念',
    description: stripMarkdown(entry.body, 80),
    date: entry.data.date,
    category: '碎碎念',
    tags: entry.data.tags,
    featured: false,
    cover: undefined,
  },
}));

const allItems = [...articles, ...projects, ...randomCards].sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout>
  <SectionHeader
    tag={site.tag}
    title={site.heroTitle}
    description={site.subtitle}
    showSocial
  />

  <CategoryCards />

  <section class="container-inner pb-16">
    <FilterBar active="all" />
    <CardGrid items={allItems} />
  </section>
</BaseLayout>

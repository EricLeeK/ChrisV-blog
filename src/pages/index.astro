---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { site } from '../data/site';
---

<BaseLayout>
  <SectionHeader
    tag={site.tag}
    title={site.heroTitle}
    description={site.subtitle}
    showSocial
  />

  <section class="container-inner py-16">
    <h2 class="text-xl font-display">Latest</h2>
    <p class="mt-4 text-ink-muted">Content coming soon.</p>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import NotePaper from '../components/NotePaper.astro';
import { getCollection, render } from 'astro:content';
import { dateLabel, noteTitle, noteExcerpt } from '../lib/reading';
import { Icon } from 'astro-icon/components';
import '../styles/reading.css';
const notes = (await getCollection('random')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latest = notes[0];
const rendered = latest ? await render(latest) : undefined;
const Content = rendered?.Content;
const older = notes.slice(1);
const years = [...new Set(older.map(note => note.data.date.getFullYear()))];
const tags = [...new Set(notes.flatMap(note => note.data.tags))];
---
<BaseLayout title="手记 — ChrisV" description="记录思考、灵感与生活片段。" reading>
  <section class="notes-index reading-width" data-notes-index>
    <header class="index-heading notes-heading"><div><h1>手记</h1><p>留一些空白，给日常与偶然的念头。</p></div><span class="collection-count">{notes.length} 封手记</span></header>
    {tags.length > 0 && <div class="note-filters"><label>按标签阅读 <select data-note-tag><option value="">全部手记</option>{tags.map(tag => <option value={tag}>{tag}</option>)}</select></label><span data-note-count aria-live="polite">{notes.length} 封</span></div>}
    {latest && Content && <div class="latest-letter" data-note-item data-tags={JSON.stringify(latest.data.tags)}><NotePaper note={latest} number={notes.length} preview><Content /></NotePaper></div>}
    {older.length > 0 && <section class="letter-archive" aria-label="往期手记"><h2>往期手记</h2>{years.map(year => <div class="archive-year" data-archive-year><h3>{year}</h3><div>{older.filter(note => note.data.date.getFullYear() === year).map(note => <article data-note-item data-tags={JSON.stringify(note.data.tags)}><time datetime={note.data.date.toISOString()}>{dateLabel(note.data.date)}</time><h4><a href={`/random/${note.id}`}>{noteTitle(note)}</a></h4><p>{noteExcerpt(note)}</p><a class="archive-read" href={`/random/${note.id}`}>手记 / {String(notes.length - notes.indexOf(note)).padStart(3, '0')} · 阅读全文</a></article>)}</div></div>)}</section>}
    <p class="notes-empty" data-note-empty hidden={notes.length > 0}>这里暂时没有手记。{notes.length > 0 && <button type="button" data-note-reset>查看全部手记</button>}</p>
    <footer class="notes-end"><span>写下的，都是生活的回声。</span><a href="/articles">去读文稿<Icon name="lucide:arrow-right" aria-hidden="true" /></a></footer>
  </section>
</BaseLayout>
<script>
  const select = document.querySelector<HTMLSelectElement>('[data-note-tag]');
  if (select) {
    const items = [...document.querySelectorAll<HTMLElement>('[data-note-item]')];
    const params = new URLSearchParams(location.search);
    select.value = params.get('tag') || '';
    function update() {
      let count = 0;
      items.forEach(item => { const matches = !select!.value || JSON.parse(item.dataset.tags || '[]').includes(select!.value); item.hidden = !matches; if(matches) count++; });
      document.querySelectorAll<HTMLElement>('[data-archive-year]').forEach(group => { group.hidden = !group.querySelector('[data-note-item]:not([hidden])'); });
      const archive = document.querySelector<HTMLElement>('.letter-archive');
      if (archive) archive.hidden = !archive.querySelector('[data-note-item]:not([hidden])');
      document.querySelector<HTMLElement>('[data-note-empty]')!.hidden = count > 0;
      document.querySelector<HTMLElement>('[data-note-count]')!.textContent = `${count} 封`;
    }
    select.addEventListener('change', () => { update(); const url = new URL(location.href); if(select.value) url.searchParams.set('tag', select.value); else url.searchParams.delete('tag'); history.replaceState(null, '', url); });
    document.querySelector('[data-note-reset]')?.addEventListener('click', () => { select.value = ''; select.dispatchEvent(new Event('change')); });
    update();
  }
</script>

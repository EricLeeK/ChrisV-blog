---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
const resources = (await getCollection('resources')).sort((a,b) => a.data.category.localeCompare(b.data.category) || a.data.title.localeCompare(b.data.title));
const categories = [...new Set(resources.map(resource => resource.data.category))];
---
<BaseLayout title="资源 — ChrisV">
  <SectionHeader title="资源" description="把值得留下的工具、论文与灵感，放在这里。" />
  <div class="reading-width resource-page">{categories.map(category => <section class="resource-group"><h2>{category}</h2><div>{resources.filter(resource => resource.data.category === category).map(resource => <a class="resource-entry" href={resource.data.url} target="_blank" rel="noopener noreferrer"><div><h3>{resource.data.title}</h3><p>{resource.data.description}</p><span>{new URL(resource.data.url).hostname}</span></div><Icon name="lucide:arrow-up-right" aria-hidden="true" /></a>)}</div></section>)}<footer class="resource-end">陆续收集，也欢迎交流你喜欢的工具与读物。<a href="/about">找到我<Icon name="lucide:arrow-right" aria-hidden="true" /></a></footer></div>
</BaseLayout>

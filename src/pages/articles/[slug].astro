---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import ReadingLayout from '../../layouts/ReadingLayout.astro';
export async function getStaticPaths() {
  const posts = (await getCollection('articles')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return posts.map((post, index) => ({ params: { slug: post.id }, props: { post, next: posts[index + 1] } }));
}
interface Props { post: CollectionEntry<'articles'>; next?: CollectionEntry<'articles'>; }
const { post, next } = Astro.props;
const { Content, headings } = await render(post);
---
<ReadingLayout {...post.data} kind="articles" body={post.body} headings={headings} next={next ? { title: next.data.title, href: `/articles/${next.id}` } : undefined}>
  <Content />
</ReadingLayout>

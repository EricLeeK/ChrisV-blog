---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialIndex from '../components/EditorialIndex.astro';
import '../styles/reading.css';
import { getCollection } from 'astro:content';
const items = (await getCollection('projects')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<BaseLayout title="项目 — ChrisV" reading><EditorialIndex items={items} kind="projects" /></BaseLayout>

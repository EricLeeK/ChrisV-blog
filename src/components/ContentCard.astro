---
import { formatDate } from '../lib/utils';

interface Props {
  title: string;
  description: string;
  date?: Date | string;
  category: string;
  tags?: string[];
  featured?: boolean;
  href: string;
  cover?: string;
}

const {
  title,
  description,
  date,
  category,
  tags = [],
  featured = false,
  href,
  cover,
} = Astro.props;

const displayDate = date ? formatDate(date) : undefined;
---

<a
  href={href}
  class="group relative flex flex-col overflow-hidden rounded-[6px] border border-[var(--border)] bg-[var(--card-color)] transition-all duration-300 hover:shadow-[var(--shadow-md)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary-main)]"
>
  <div class="relative aspect-[2/3] overflow-hidden">
    {
      cover ? (
        <img
          src={cover}
          alt={title}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-[var(--color-200)] text-[var(--color-500)]">
          <span class="ricoui-tag">{category}</span>
        </div>
      )
    }

    {featured && (
      <span
        class="absolute top-3 right-3 rounded-[36px] bg-[var(--color-blue)] px-2.5 py-1 text-xs font-medium text-white"
      >
        推荐
      </span>
    )}
  </div>

  <div class="flex flex-1 flex-col gap-2 p-4">
    <div class="flex items-center gap-2">
      <span class="ricoui-tag text-[var(--color-500)]">{category}</span>
      {tags.length > 0 && (
        <span class="text-xs text-[var(--color-600)]">{tags.slice(0, 3).join(' · ')}</span>
      )}
    </div>

    <h3 class="text-base font-medium leading-snug text-[var(--color-0)] group-hover:text-[var(--color-primary-main)]">
      {title}
    </h3>

    <p class="line-clamp-2 text-sm leading-relaxed text-[var(--color-300)]">
      {description}
    </p>

    {displayDate && (
      <time class="mt-auto pt-2 text-xs text-[var(--color-500)]" datetime={typeof date === 'string' ? date : date?.toISOString()}>
        {displayDate}
      </time>
    )}
  </div>
</a>

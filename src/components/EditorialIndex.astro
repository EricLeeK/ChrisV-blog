---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import ContentRows from './ContentRows.astro';
interface Props {
  items: (CollectionEntry<'articles'> | CollectionEntry<'projects'> | CollectionEntry<'blogArchive'>)[];
  kind: 'articles' | 'projects' | 'blog-archive';
}
const { items, kind } = Astro.props;
const projects = kind === 'projects';
const archived = kind === 'blog-archive';
const title = projects ? '项目' : archived ? '优秀博客转存' : '文稿';
const unit = projects ? '个项目' : archived ? '篇转存' : '篇文稿';
const categories = [...new Set(items.map(item => item.data.category))];
const tags = [...new Set(items.flatMap(item => item.data.tags))].sort();
---
<section class="editorial-index reading-width" data-editorial-index>
  <header class="index-heading">
    <div><h1>{title}</h1><p>{projects ? '把想法做成可以使用的东西。' : archived ? '把值得反复阅读的博客，译成中文，连同配图一起留下。' : '关于智能、创造，以及理解世界的过程。'}</p></div>
    <span class="collection-count">{items.length} {unit}</span>
  </header>
  <div class="index-toolbar">
    <label class="search-field"><Icon name="lucide:search" aria-hidden="true" /><span class="sr-only">搜索{title}</span><input type="search" placeholder={projects ? '搜索项目、技术或关键词' : archived ? '搜索译文标题、摘要或关键词' : '搜索标题、摘要或关键词'} data-search /></label>
    <label class="select-field"><span class="sr-only">标签筛选</span><select data-tag><option value="">全部标签</option>{tags.map(tag => <option value={tag}>{tag}</option>)}</select></label>
    <label class="select-field"><span class="sr-only">排序</span><select data-sort><option value="newest">最新发布</option><option value="oldest">最早发布</option></select></label>
    <div class="view-switch" role="group" aria-label="显示方式">
      <button type="button" data-view="compact" aria-label="紧凑列表" aria-pressed="true"><Icon name="lucide:list" /></button>
      <button type="button" data-view="grid" aria-label="封面网格" aria-pressed="false"><Icon name="lucide:layout-grid" /></button>
    </div>
  </div>
  <div class="category-tabs" role="group" aria-label="分类筛选">
    <button type="button" data-category="" aria-pressed="true">全部<span>{items.length}</span></button>
    {categories.map(category => <button type="button" data-category={category} aria-pressed="false">{category}</button>)}
  </div>
  <div class="editorial-entries" data-entries data-view-mode="compact">
    <ContentRows items={items} />
  </div>
  <div class="index-empty" data-empty hidden><h2>没有找到匹配的内容</h2><p>换个关键词，或清除筛选再看看。</p><button type="button" data-reset>清除搜索和筛选</button></div>
  <footer class="index-footer"><span data-result-count role="status" aria-live="polite">共 {items.length} {unit}</span><a href={projects || archived ? '/articles' : '/random'}>{projects || archived ? '读读文稿' : '也看看手记'}<Icon name="lucide:arrow-right" aria-hidden="true" /></a></footer>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-editorial-index]').forEach(root => {
    const search = root.querySelector<HTMLInputElement>('[data-search]')!;
    const tag = root.querySelector<HTMLSelectElement>('[data-tag]')!;
    const sort = root.querySelector<HTMLSelectElement>('[data-sort]')!;
    const list = root.querySelector<HTMLElement>('[data-entries]')!;
    const entries = [...root.querySelectorAll<HTMLElement>('[data-entry]')];
    const categories = [...root.querySelectorAll<HTMLButtonElement>('button[data-category]')];
    const views = [...root.querySelectorAll<HTMLButtonElement>('[data-view]')];
    let category = '';
    let legacyFilter = '';
    const params = new URLSearchParams(location.search);
    search.value = params.get('q') || '';
    tag.value = params.get('tag') || '';
    if (params.get('sort') === 'oldest') sort.value = 'oldest';
    const requestedCategory = params.get('category') || '';
    if (categories.some(button => button.dataset.category === requestedCategory)) category = requestedCategory;
    const requestedFilter = params.get('filter') || '';
    if (requestedFilter !== 'all' && entries.some(entry => entry.dataset.filterSlugs?.split(',').includes(requestedFilter))) legacyFilter = requestedFilter;
    let view = params.get('view_mode') === 'grid' ? 'grid' : 'compact';
    function update(persist = true) {
      const query = search.value.trim().toLocaleLowerCase();
      let count = 0;
      const ordered = [...entries].sort((a, b) => (Number(b.dataset.date) - Number(a.dataset.date)) * (sort.value === 'oldest' ? -1 : 1));
      ordered.forEach(entry => {
        const matches = (!category || entry.dataset.category === category) && (!legacyFilter || !!entry.dataset.filterSlugs?.split(',').includes(legacyFilter)) && (!tag.value || JSON.parse(entry.dataset.tags || '[]').includes(tag.value)) && (!query || entry.dataset.searchText?.includes(query));
        entry.hidden = !matches;
        if (matches) count++;
        list.append(entry);
      });
      categories.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.category === category && !legacyFilter)));
      views.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.view === view)));
      list.dataset.viewMode = view;
      root.querySelector<HTMLElement>('[data-empty]')!.hidden = count > 0;
      root.querySelector<HTMLElement>('[data-result-count]')!.textContent = `显示 ${count} / ${entries.length} 项`;
      if (persist) {
        const url = new URL(location.href);
        const state: Record<string, string> = { q: search.value, tag: tag.value, category, sort: sort.value === 'oldest' ? 'oldest' : '', view_mode: view === 'grid' ? 'grid' : '', filter: legacyFilter };
        Object.entries(state).forEach(([key, value]) => value ? url.searchParams.set(key, value) : url.searchParams.delete(key));
        history.replaceState(null, '', url);
      }
    }
    categories.forEach(button => button.addEventListener('click', () => { category = button.dataset.category || ''; legacyFilter = ''; update(); }));
    views.forEach(button => button.addEventListener('click', () => { view = button.dataset.view || 'compact'; update(); }));
    search.addEventListener('input', () => update());
    tag.addEventListener('change', () => update());
    sort.addEventListener('change', () => update());
    root.querySelector('[data-reset]')?.addEventListener('click', () => { search.value = ''; tag.value = ''; category = ''; legacyFilter = ''; update(); search.focus(); });
    update(false);
  });
</script>

---
export type MagicState = 'DESIGN' | 'SKILL' | 'NEED3D' | 'OFF';

const states: MagicState[] = ['DESIGN', 'SKILL', 'NEED3D', 'OFF'];
---

<button
  type="button"
  class="magic-switch inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold transition-transform hover:scale-105 active:scale-95"
  aria-label="切换 Magic Click 状态"
  data-states={JSON.stringify(states)}
>
  <span class="magic-switch-text">Magic Click!</span>
  <span class="magic-switch-state ml-1.5 rounded-full bg-current px-1.5 py-0.5 text-[10px] opacity-90">OFF</span>
</button>

<style>
  .magic-switch {
    color: var(--color-999);
    background-color: var(--color-yellow);
    box-shadow: 0 0 10px 3px rgba(247, 210, 82, 0.35);
  }
  .magic-switch:hover {
    box-shadow: 0 0 16px 5px rgba(247, 210, 82, 0.5);
  }
  .magic-switch[data-current-state='DESIGN'] {
    background-color: var(--color-yellow);
    color: var(--color-999);
  }
  .magic-switch[data-current-state='SKILL'] {
    background-color: var(--color-pink);
    color: #fff;
  }
  .magic-switch[data-current-state='NEED3D'] {
    background-color: var(--color-cyan);
    color: var(--color-999);
  }
  .magic-switch[data-current-state='OFF'] {
    background-color: var(--color-300);
    color: var(--color-999);
    box-shadow: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .magic-switch {
      transition: none !important;
    }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLElement>('.magic-switch');

  buttons.forEach((button) => {
    const states: string[] = JSON.parse(button.dataset.states || '[]');
    const stateEl = button.querySelector<HTMLElement>('.magic-switch-state');
    let index = states.indexOf('OFF');
    if (index < 0) index = 0;

    function setState(nextIndex: number) {
      index = nextIndex % states.length;
      const state = states[index];
      button.dataset.currentState = state;
      if (stateEl) stateEl.textContent = state;

      window.dispatchEvent(
        new CustomEvent('magicstatechange', {
          detail: { state },
          bubbles: true,
          cancelable: true,
        })
      );
    }

    // initialize
    setState(index);

    button.addEventListener('click', () => {
      setState(index + 1);
    });
  });
</script>

---
import type { MarkdownHeading } from 'astro';
interface Props { headings: MarkdownHeading[]; mobile?: boolean; }
const { headings, mobile = false } = Astro.props;
---
<nav class="reading-outline" data-reading-outline aria-label={mobile ? '移动端文章目录' : '文章目录'}>
  <div class="outline-heading"><span>本文目录</span><span data-outline-percent aria-hidden="true">0%</span></div>
  <div class="outline-map" data-outline-map>
    <svg class="outline-wave" data-outline-wave aria-hidden="true" width="32" height="200" viewBox="0 0 32 200" fill="none">
      <path class="outline-track" data-wave-track d="M16 0V200" />
      <path class="outline-trail" data-wave-trail d="M16 0V0" />
      <circle class="outline-position" data-wave-dot cx="16" cy="0" r="3" />
    </svg>
    <div class="outline-links" data-outline-links>{headings.map(heading => <a class:list={{ nested: heading.depth === 3 }} href={`#${heading.slug}`} data-outline-link>{heading.text}</a>)}</div>
  </div>
</nav>
<script>
  document.querySelectorAll<HTMLElement>('[data-reading-outline]').forEach(root => {
    const map = root.querySelector<HTMLElement>('[data-outline-map]')!;
    const list = root.querySelector<HTMLElement>('[data-outline-links]')!;
    const links = [...root.querySelectorAll<HTMLAnchorElement>('[data-outline-link]')];
    const headings = links.map(link => document.getElementById(decodeURIComponent(link.hash.slice(1))));
    const svg = root.querySelector<SVGSVGElement>('[data-outline-wave]')!;
    const track = root.querySelector<SVGPathElement>('[data-wave-track]')!;
    const trail = root.querySelector<SVGPathElement>('[data-wave-trail]')!;
    const dot = root.querySelector<SVGCircleElement>('[data-wave-dot]')!;
    const percent = root.querySelector<HTMLElement>('[data-outline-percent]')!;
    const body = document.querySelector<HTMLElement>('[data-article-body]');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let centers: number[] = [];
    let height = 200;
    let target = 0;
    let position = 0;
    let speed = 0;
    let energy = 0;
    let phase = 0;
    let frame = 0;
    let previousY = scrollY;
    let active = -1;
    let previousTime = 0;
    const visible = () => root.getBoundingClientRect().width > 0 && !document.hidden;
    function measure() {
      if (!visible()) return;
      const bounds = map.getBoundingClientRect();
      height = Math.max(1, list.offsetHeight);
      centers = links.map(link => { const rect = link.getBoundingClientRect(); return rect.top - bounds.top + rect.height / 2; });
      svg.setAttribute('viewBox', `0 0 32 ${height}`);
      svg.setAttribute('height', String(height));
      update();
    }
    function update() {
      if (!visible() || !centers.length) return;
      const offset = (document.querySelector('body > header')?.getBoundingClientRect().height || 70) + 40;
      const bodyBounds = body?.getBoundingClientRect();
      const reachedEnd = !!bodyBounds && (bodyBounds.bottom <= innerHeight - 24 || scrollY + innerHeight >= document.documentElement.scrollHeight - 3);
      let index = 0;
      headings.forEach((heading, i) => { if (heading && heading.getBoundingClientRect().top <= offset) index = i; });
      if (reachedEnd) index = headings.length - 1;
      const current = headings[index];
      const next = headings[index + 1];
      let section = 0;
      if (current && next) section = Math.min(1, Math.max(0, (offset - current.getBoundingClientRect().top) / Math.max(1, next.offsetTop - current.offsetTop)));
      target = centers[index] + ((centers[index + 1] ?? centers[index]) - centers[index]) * section;
      if (active !== index) {
        active = index;
        links.forEach((link, i) => i === index ? link.setAttribute('aria-current', 'location') : link.removeAttribute('aria-current'));
      }
      if (body) {
        const bounds = body.getBoundingClientRect();
        const progress = reachedEnd ? 1 : Math.min(1, Math.max(0, (offset - bounds.top + innerHeight * .35) / Math.max(1, bounds.height)));
        percent.textContent = `${Math.round(progress * 100)}%`;
      }
      const delta = scrollY - previousY;
      previousY = scrollY;
      energy = reduced.matches ? 0 : Math.min(9, energy + Math.abs(delta) * .09);
      if (reduced.matches) { position = target; speed = 0; paint(); }
      else if (!frame) frame = requestAnimationFrame(tick);
    }
    function paint() {
      const first = centers[0] || 0;
      const last = centers.at(-1) || height;
      const waveX = (y: number) => {
        const distance = y - position;
        return 16 + Math.sin(distance * .13 + phase) * energy * Math.exp(-(distance * distance) / 2200);
      };
      const path = (end: number) => {
        let d = `M${waveX(first).toFixed(2)} ${first.toFixed(2)}`;
        for (let y = first + 2; y < end; y += 2) d += `L${waveX(y).toFixed(2)} ${y.toFixed(2)}`;
        return `${d}L${waveX(end).toFixed(2)} ${end.toFixed(2)}`;
      };
      track.setAttribute('d', path(last));
      trail.setAttribute('d', path(Math.max(first, Math.min(last, position))));
      dot.setAttribute('cx', waveX(position).toFixed(2));
      dot.setAttribute('cy', position.toFixed(2));
      root.dataset.waveActive = energy > .15 ? 'true' : 'false';
    }
    function tick(time: number) {
      frame = 0;
      if (!visible()) { energy = 0; return; }
      const dt = previousTime ? Math.min(2, (time - previousTime) / 16.67) : 1;
      previousTime = time;
      speed = (speed + (target - position) * .075 * dt) * Math.pow(.73, dt);
      position += speed * dt;
      energy *= Math.pow(.94, dt);
      phase += .08 * dt;
      paint();
      if (Math.abs(target - position) > .05 || Math.abs(speed) > .04 || energy > .04) frame = requestAnimationFrame(tick);
      else { position = target; energy = 0; previousTime = 0; paint(); }
    }
    const observer = new ResizeObserver(measure);
    observer.observe(list);
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', measure);
    addEventListener('hashchange', update);
    document.addEventListener('visibilitychange', () => { if (document.hidden) { cancelAnimationFrame(frame); frame = 0; energy = 0; } else measure(); });
    reduced.addEventListener('change', () => { cancelAnimationFrame(frame); frame = 0; energy = 0; position = target; paint(); });
    root.closest('details')?.addEventListener('toggle', measure);
    document.fonts.ready.then(measure);
    measure();
  });
</script>

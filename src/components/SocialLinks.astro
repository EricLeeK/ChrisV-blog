---
import { social } from '../data/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<ul class:list={['flex flex-wrap items-center justify-center gap-4', className]} aria-label="Social links">
  {
    social.map((item) => (
      <li>
        <a
          href={item.href}
          target={item.href.startsWith('mailto:') || item.href.startsWith('#') ? undefined : '_blank'}
          rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="text-sm text-[var(--color-0)] opacity-75 transition-opacity hover:opacity-100"
        >
          {item.label}
        </a>
      </li>
    ))
  }
</ul>

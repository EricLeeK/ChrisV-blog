---
import SocialLinks from './SocialLinks.astro';

interface Props {
  tag: string;
  title: string;
  description?: string;
  showSocial?: boolean;
}

const { tag, title, description, showSocial = false } = Astro.props;
---

<section class="flex flex-col items-center gap-4 py-16 text-center sm:py-20">
  <span
    class="inline-flex items-center rounded-[36px] border border-[var(--border)] px-4 py-1.5 text-[13px] uppercase tracking-wider text-[var(--color-0)]"
    style="font-family: var(--font-tag);"
  >
    {tag}
  </span>

  <h1
    class="text-4xl sm:text-5xl lg:text-6xl text-[var(--color-0)]"
    style="font-family: var(--font-display);"
  >
    {title}
  </h1>

  {
    description && (
      <p class="max-w-[480px] text-base leading-relaxed text-[var(--color-300)] text-balance">
        {description}
      </p>
    )
  }

  {showSocial && <SocialLinks class="mt-2" />}
</section>

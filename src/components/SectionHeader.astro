---
import SocialLinks from './SocialLinks.astro';
interface Props { tag?: string; title: string; description?: string; showSocial?: boolean; }
const { title, description, showSocial = false } = Astro.props;
---
<header class="page-header reading-width"><h1>{title}</h1>{description && <p>{description}</p>}{showSocial && <SocialLinks />}</header>

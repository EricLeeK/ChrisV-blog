---
import { categories } from '../data/site';
---

<section class="container-inner py-8">
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      categories.map((cat) => (
        <a
          href={cat.href}
          class="group flex flex-col gap-1 rounded-[6px] border border-[var(--border)] bg-[var(--card-color)] p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-[var(--shadow-md)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary-main)]"
        >
          <h3 class="text-xl text-[var(--color-0)]">{cat.title}</h3>
          <p class="text-sm text-[var(--color-300)]">{cat.subtitle}</p>
        </a>
      ))
    }
  </div>
</section>

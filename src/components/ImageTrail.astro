---
// Client-side cursor trail component.
// Listens for the custom `magicstatechange` event and follows the cursor
// when the state is not OFF. Hidden on viewports narrower than 768px.
---

<div
  class="image-trail pointer-events-none fixed inset-0 z-40 hidden md:block"
  aria-hidden="true"
  data-state="OFF"
>
  {Array.from({ length: 6 }).map((_, i) => (
    <span
      class="trail-item absolute left-0 top-0 flex h-8 w-8 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full text-sm opacity-0 shadow-lg will-change-transform"
      data-index={i}
    >
      <span class="trail-dot h-3.5 w-3.5 rounded-full" />
    </span>
  ))}
</div>

<style>
  .trail-item {
    transition: opacity 0.2s ease;
  }
  .trail-item.is-active {
    opacity: 1;
  }
  .trail-dot {
    background-color: var(--trail-color, var(--color-yellow));
    box-shadow:
      inset -2px -2px 4px rgba(0, 0, 0, 0.15),
      inset 2px 2px 4px rgba(255, 255, 255, 0.35),
      0 4px 10px rgba(0, 0, 0, 0.25);
  }
  .image-trail[data-state='DESIGN'] .trail-dot {
    --trail-color: var(--color-yellow);
  }
  .image-trail[data-state='SKILL'] .trail-dot {
    --trail-color: var(--color-pink);
  }
  .image-trail[data-state='NEED3D'] .trail-dot {
    --trail-color: var(--color-cyan);
  }
</style>

<script>
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const trail = document.querySelector<HTMLElement>('.image-trail');
    if (!trail) return;

    const items = Array.from(trail.querySelectorAll<HTMLElement>('.trail-item'));
    const positions: { x: number; y: number }[] = items.map(() => ({ x: -100, y: -100 }));
    let current = { x: -100, y: -100 };
    let active = false;
    let rafId: number | null = null;

    function setVisible(state: string) {
      active = state !== 'OFF';
      if (trail) trail.dataset.state = state;
      items.forEach((item) => item.classList.toggle('is-active', active));
      if (!active && rafId !== null) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
      if (active && rafId === null) {
        rafId = requestAnimationFrame(animate);
      }
    }

    function lerp(start: number, end: number, factor: number) {
      return start + (end - start) * factor;
    }

    function animate() {
      positions.forEach((pos, i) => {
        const target = i === 0 ? current : positions[i - 1];
        const delay = 0.22 + i * 0.04;
        pos.x = lerp(pos.x, target.x, delay);
        pos.y = lerp(pos.y, target.y, delay);
        const item = items[i];
        if (item) {
          item.style.transform = `translate(${pos.x}px, ${pos.y}px) translate(-50%, -50%)`;
        }
      });
      rafId = requestAnimationFrame(animate);
    }

    window.addEventListener('magicstatechange', (event: Event) => {
      const detail = (event as CustomEvent).detail || {};
      setVisible(detail.state || 'OFF');
    });

    window.addEventListener('mousemove', (e) => {
      current = { x: e.clientX, y: e.clientY };
    });

    window.addEventListener('touchmove', (e) => {
      const touch = e.touches[0];
      if (touch) {
        current = { x: touch.clientX, y: touch.clientY };
      }
    });

    // Start with current state if MagicSwitch has already initialized.
    if (trail.dataset.state && trail.dataset.state !== 'OFF') {
      setVisible(trail.dataset.state);
    }
  })();
</script>
